    "test:cli-args": "node --test src/cli/args.test.mjs",
    "test:analysis-pipeline": "node --test src/cli/analysis-pipeline.test.mjs",
    "test:run-bundle-stage": "node --test src/cli/run-bundle-stage.test.mjs",
    "test:spark-label-stage": "node --test src/cli/spark-label-stage.test.mjs",
    "test:run-preparation": "node --test src/cli/run-preparation.test.mjs",
    "test:meta-retry-policy": "node --test src/cli/meta-retry-policy.test.mjs",
    "test:meta-file-client": "node --test src/cli/meta-file-client.test.mjs",
