    "test:meta-sam-run": "node --test src/cli/meta-sam-run.test.mjs",
    "test:sam-event-stage": "node --test src/cli/sam-event-stage.test.mjs",
    "test:segment-correspondence": "node --test src/cli/segment-correspondence-audit.test.mjs",
