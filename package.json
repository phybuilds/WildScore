{
  "name": "wildscore",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Evidence-linked review notebook for short wildlife videos.",
  "bin": {
    "wildscore": "bin/wildscore.mjs"
  },
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11.19.1 <12"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "test": "npm run test:cli-args && npm run test:analysis-pipeline && npm run test:run-bundle-stage && npm run test:spark-label-stage && npm run test:run-preparation && npm run test:meta-retry-policy && npm run test:meta-file-client && npm run test:meta-sam-client && npm run test:meta-sam-run && npm run test:sam-event-stage && npm run test:segment-correspondence && npm run test:segment-timebase && npm run test:segment-audit-csv && npm run test:correspondence-bundle && npm run test:recovery-batch && npm run test:demo-integrity && npm run test:http-range && npm run test:sam-parser && npm run test:sam-run-config && npm run test:sam-object-prompt && npm run test:missing-animal-annotation && npm run test:missing-animal-queue && npm run test:events && npm run test:track-overlap && npm run test:schema && npm run test:recovery-schema && npm run test:correspondence-schema && npm run test:correspondence-view && npm run test:load-demo && npm run test:public-demo && npm run test:view-model && npm run test:review && npm run test:recovery-review && npm run test:correspondence-audit-review && npm run test:csv && npm run test:track-summary-csv && npm run test:recovery-csv && npm run test:correspondence-audit-csv && npm run test:audio && npm run test:scheduler && npm run test:evaluation && npm run test:local-overlay && npm run test:evidence-summary && npm run test:saved-replay && npm run test:review-flow",
    "dev": "next dev web --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit -p web/tsconfig.json",
    "check:public": "node scripts/check-public-output.mjs",
    "demo": "node bin/wildscore.mjs --demo",
    "demo:prepare": "node scripts/prepare-local-demo.mjs",
    "demo:prepare-recovery-review": "node scripts/prepare-local-demo.mjs --review-recovery-batch",
    "demo:build-reviewed": "node scripts/build-reviewed-demo-bundle.mjs",
    "demo:build-recovery": "node scripts/build-recovery-candidates.mjs",
    "demo:build-reviewed-recovery": "node scripts/build-reviewed-recovery-bundle.mjs",
    "labels:prepare-recovery": "node scripts/prepare-recovery-label-evidence.mjs",
    "labels:run-recovery": "node --env-file=.env.local scripts/meta-spark-recovery-labels.mjs",
    "labels:build-recovery": "node scripts/build-recovery-label-bundle.mjs",
    "labels:build-reviewed-recovery": "node scripts/build-reviewed-recovery-label-bundle.mjs",
    "prebuild": "npm run check:public",
    "build": "next build web && npm run check:public",
    "check:model-key": "node --env-file=.env.local scripts/check-model-key.mjs",
