{
  "name": "wildscore",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Evidence-linked review notebook for short wildlife videos.",
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11.19.1 <12"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "test": "npm run test:sam-parser && npm run test:sam-run-config && npm run test:sam-object-prompt && npm run test:missing-animal-annotation && npm run test:events && npm run test:track-overlap && npm run test:schema && npm run test:recovery-schema && npm run test:public-demo && npm run test:view-model && npm run test:review && npm run test:recovery-review && npm run test:csv && npm run test:recovery-csv && npm run test:audio && npm run test:scheduler && npm run test:evaluation && npm run test:evidence-summary && npm run test:review-flow",
    "dev": "next dev web --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit -p web/tsconfig.json",
    "check:public": "node scripts/check-public-output.mjs",
    "demo:prepare": "node scripts/prepare-local-demo.mjs",
    "demo:build-reviewed": "node scripts/build-reviewed-demo-bundle.mjs",
    "demo:build-recovery": "node scripts/build-recovery-candidates.mjs",
    "demo:build-reviewed-recovery": "node scripts/build-reviewed-recovery-bundle.mjs",
    "labels:prepare-recovery": "node scripts/prepare-recovery-label-evidence.mjs",
    "labels:run-recovery": "node --env-file=.env.local scripts/meta-spark-recovery-labels.mjs",
    "labels:build-recovery": "node scripts/build-recovery-label-bundle.mjs",
    "labels:build-reviewed-recovery": "node scripts/build-reviewed-recovery-label-bundle.mjs",
    "prebuild": "npm run check:public",
    "build": "next build web && npm run check:public",
    "check:model-key": "node --env-file=.env.local scripts/check-model-key.mjs",
    "test:sam-parser": "node --test scripts/lib/sam-output.test.mjs",
    "test:sam-run-config": "node --test scripts/lib/sam-run-config.test.mjs",
    "test:sam-object-prompt": "node --test scripts/lib/sam-object-prompt.test.mjs",
    "test:missing-animal-annotation": "node --test src/recovery/missing-animal-annotation.test.ts",
    "test:schema": "node --test src/data/bundle-schema.test.ts",
    "test:recovery-schema": "node --test src/data/recovery-schema.test.ts",
    "test:public-demo": "node --test src/data/public-demo.test.ts",
    "test:view-model": "node --test src/data/view-model.test.ts",
    "test:review": "node --test src/review/review-state.test.ts",
    "test:recovery-review": "node --test src/review/recovery-state.test.ts",
    "test:csv": "node --test src/export/event-csv.test.ts",
    "test:recovery-csv": "node --test src/export/recovery-csv.test.ts",
    "test:audio": "node --test src/audio/cue-builder.test.ts",
    "test:scheduler": "node --test src/audio/scheduler.test.ts",
    "test:evaluation": "node --test src/evaluation/event-matcher.test.ts",
    "test:evidence-summary": "node --test src/evaluation/evidence-summary.test.ts",
    "test:review-flow": "node --test src/integration/review-flow.test.ts",
    "feasibility:meta": "node --env-file=.env.local scripts/meta-feasibility.mjs",
    "evaluate:sam-heldout": "node --env-file=.env.local scripts/meta-feasibility.mjs --clip=heldout-02 --fps=10",
    "prepare:sam-15fps": "node scripts/prepare-analysis-derivative.mjs --fps=15",
    "experiment:sam-15fps": "node --env-file=.env.local scripts/meta-feasibility.mjs --fps=15",
    "compare:sam-temporal": "node scripts/compare-sam-temporal-runs.mjs",
    "diagnose:sam-15fps": "node scripts/render-sam-diagnostic-frames.mjs",
    "experiment:sam-antelope": "node --env-file=.env.local scripts/meta-feasibility.mjs --fps=15 --prompt=antelope",
    "experiment:sam-baboon": "node --env-file=.env.local scripts/meta-feasibility.mjs --fps=15 --prompt=baboon",
    "experiment:sam-hippo": "node --env-file=.env.local scripts/meta-feasibility.mjs --fps=15 --prompt=hippo",
    "experiment:sam-hippopotamus": "node --env-file=.env.local scripts/meta-feasibility.mjs --fps=15 --prompt=hippopotamus",
    "evaluate:sam-targeted-recall": "node scripts/evaluate-sam-targeted-recall.mjs",
    "audit:sam-concept-merge": "node scripts/audit-sam-concept-merge.mjs",
    "prepare:spark-evidence": "node scripts/prepare-spark-evidence.mjs",
    "feasibility:spark": "node --env-file=.env.local scripts/meta-spark-label.mjs",
    "experiment:spark-context": "node --env-file=.env.local scripts/meta-spark-context-ab.mjs",
    "build:bundle": "node scripts/build-result-bundle.mjs",
    "test:events": "node --test scripts/lib/presence-segments.test.mjs",
    "test:track-overlap": "node --test scripts/lib/track-overlap.test.mjs"
  },
  "dependencies": {
    "@meta-sam/parser": "0.1.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3"
  }
}
